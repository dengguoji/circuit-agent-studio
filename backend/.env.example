# Backend server
CIRCUIT_AGENT_HOST=127.0.0.1
CIRCUIT_AGENT_PORT=8787
# Browser origin allowed for direct cross-origin API requests.
CIRCUIT_ALLOWED_ORIGIN=http://localhost:5178
# Local conversation database and uploaded image cache (both should stay ignored)
CIRCUIT_DATABASE_PATH=./tmp/circuit_agent.sqlite3
CIRCUIT_ASSET_DIR=./tmp/assets
# Unabridged local model context/request/response JSON. May contain user text,
# tool results and inline image data; do not commit or share this directory.
CIRCUIT_CONTEXT_HISTORY_ENABLED=false
CIRCUIT_CONTEXT_HISTORY_DIR=./context_history
# Provider Files API polling (the request returns "processing" after this budget)
CIRCUIT_FILE_POLL_ATTEMPTS=20
CIRCUIT_FILE_POLL_INTERVAL=0.25
# Timeout for Bailian temporary OSS policy/upload requests.
CIRCUIT_ASSET_UPLOAD_TIMEOUT=30

# Alibaba Cloud Model Studio / DashScope OpenAI-compatible API
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_ENABLE_THINKING=false
# Set false only when the selected endpoint does not implement Responses API.
BAILIAN_RESPONSES_ENABLED=true
# Optional; enables context percentage reporting when known for the selected model.
# BAILIAN_CONTEXT_WINDOW=
BAILIAN_API_KEY=
# DASHSCOPE_API_KEY=
# ALIBABA_CLOUD_API_KEY=

# ByteDance Volcano Engine Ark OpenAI-compatible API
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-2.0-pro-250515
DOUBAO_RESPONSES_ENABLED=true
# Files API purpose used for uploaded circuit reference images.
DOUBAO_FILE_PURPOSE=user_data
# DOUBAO_CONTEXT_WINDOW=
DOUBAO_API_KEY=
# ARK_API_KEY=
# VOLCENGINE_API_KEY=

# LangSmith tracing is opt-in because traces may contain user and tool data.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=circuit-agent-studio
LANGSMITH_API_KEY=
